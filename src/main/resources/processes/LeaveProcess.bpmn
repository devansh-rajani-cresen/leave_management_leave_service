      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="managerApprovedOrNot" id="BPMNShape_managerApprovedOrNot">
        <omgdc:Bounds height="40.0" width="40.0" x="708.0" y="142.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="managerRejected" id="BPMNShape_managerRejected">
        <omgdc:Bounds height="71.0" width="192.0" x="870.0" y="127.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endevent1" id="BPMNShape_endevent1">
        <omgdc:Bounds height="35.0" width="35.0" x="1115.0" y="145.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="HRReview" id="BPMNShape_HRReview">
        <omgdc:Bounds height="55.0" width="105.0" x="900.0" y="295.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="HRApprovedOrNot" id="BPMNShape_HRApprovedOrNot">
        <omgdc:Bounds height="40.0" width="40.0" x="1122.0" y="302.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="HRApproved" id="BPMNShape_HRApproved">
        <omgdc:Bounds height="71.0" width="191.0" x="1530.0" y="229.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endevent2" id="BPMNShape_endevent2">
        <omgdc:Bounds height="35.0" width="35.0" x="1760.0" y="247.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="HRRejected" id="BPMNShape_HRRejected">
        <omgdc:Bounds height="71.0" width="186.0" x="1247.0" y="356.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="endevent3" id="BPMNShape_endevent3">
        <omgdc:Bounds height="35.0" width="35.0" x="1530.0" y="374.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="calculateReminderDate" id="BPMNShape_calculateReminderDate">
        <omgdc:Bounds height="63.0" width="131.0" x="290.0" y="131.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="sendReminderMailToManager" id="BPMNShape_sendReminderMailToManager">
        <omgdc:Bounds height="81.0" width="131.0" x="310.0" y="303.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="deductLeavefromBalance" id="BPMNShape_deductLeavefromBalance">
        <omgdc:Bounds height="71.0" width="187.0" x="1246.0" y="229.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="notifyHR" id="BPMNShape_notifyHR">
        <omgdc:Bounds height="67.0" width="195.0" x="631.0" y="289.0"></omgdc:Bounds>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="notifyingManagerFlow" id="BPMNEdge_notifyingManagerFlow">
        <omgdi:waypoint x="54.0" y="162.0"></omgdi:waypoint>
        <omgdi:waypoint x="120.0" y="162.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="managerDecisionFlow" id="BPMNEdge_managerDecisionFlow">
        <omgdi:waypoint x="585.0" y="162.0"></omgdi:waypoint>
        <omgdi:waypoint x="708.0" y="162.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="48.0" width="100.0" x="608.0" y="126.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="managerRejectionFlow" id="BPMNEdge_managerRejectionFlow">
        <omgdi:waypoint x="748.0" y="162.0"></omgdi:waypoint>
        <omgdi:waypoint x="870.0" y="162.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="16.0" width="16.0" x="784.0" y="142.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="flow6" id="BPMNEdge_flow6">
        <omgdi:waypoint x="1062.0" y="162.0"></omgdi:waypoint>
        <omgdi:waypoint x="1115.0" y="162.0"></omgdi:waypoint>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="managerApprovalFlow" id="BPMNEdge_managerApprovalFlow">
        <omgdi:waypoint x="728.0" y="182.0"></omgdi:waypoint>
        <omgdi:waypoint x="728.0" y="289.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="16.0" width="23.0" x="658.0" y="222.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="HRDecisionFlow" id="BPMNEdge_HRDecisionFlow">
        <omgdi:waypoint x="1005.0" y="322.0"></omgdi:waypoint>
        <omgdi:waypoint x="1122.0" y="322.0"></omgdi:waypoint>
