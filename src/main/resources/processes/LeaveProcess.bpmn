        <omgdi:waypoint x="375.0" y="303.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="48.0" width="100.0" x="499.0" y="250.0"></omgdc:Bounds>
        </bpmndi:BPMNLabel>
