        <omgdi:waypoint x="1142.0" y="264.0"></omgdi:waypoint>
        <omgdi:waypoint x="1246.0" y="264.0"></omgdi:waypoint>
        <bpmndi:BPMNLabel>
          <omgdc:Bounds height="16.0" width="23.0" x="1154.0" y="233.0"></omgdc:Bounds>
